# Copy to .env (make setup does this). Never commit .env.

# SQLite database location (default: backend/var/app.db)
# DATABASE_URL=sqlite:////absolute/path/to/app.db

# Google Sheets service-account key. Default: secrets/service-account.json (gitignored), which is
# where Settings → Google Sheets → Upload puts it. Set this only to keep the key elsewhere.
# Relative paths are resolved from backend/. See docs/GOOGLE_SHEETS_SETUP.md.
# GOOGLE_SERVICE_ACCOUNT_FILE=/home/you/keys/portfolio-bot.json

LOG_LEVEL=INFO

# This app never needs broker credentials. Do not put Groww login details anywhere.

# Change if 8000/5173 are already taken on your machine (used by make dev and docker compose)
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
